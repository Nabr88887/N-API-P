# Placeholder-only deployment environment. Replace every REPLACE_* value in
# an operator-owned file before use. Never commit that rendered file.

# Independent PostgreSQL for N-API-P. Use a managed TLS policy appropriate for
# the internal network; do not place a real password in this repository.
N_API_P_DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME?sslmode=verify-full

# NewAPI must be HTTPS. The token is read from a separate root-owned 0400 file.
N_API_P_NEWAPI_BASE_URL=https://REPLACE_NEWAPI_HOST
N_API_P_NEWAPI_TOKEN_FILE=/run/secrets/newapi-token

# The audit keyring is a separate root-owned 0400 JSON file. Keep old key
# versions needed to decrypt retained records when rotating the active key.
N_API_P_AUDIT_KEY_FILE=/run/secrets/audit-master-key

# The reverse proxy reaches this address over the private container network.
# Do not publish this port to an employee-facing host interface.
N_API_P_LISTEN_ADDRESS=:8080

# Retention is bounded by the implementation at one through 30 days.
N_API_P_RAW_RETENTION_DEFAULT_DAYS=7
N_API_P_RAW_RETENTION_MAX_DAYS=30

# Optional NewAPI transport bounds. Defaults are shown; values must remain
# within the implementation's documented minimum and maximum ranges.
N_API_P_NEWAPI_CONNECT_TIMEOUT=5s
N_API_P_NEWAPI_TLS_HANDSHAKE_TIMEOUT=5s
N_API_P_NEWAPI_RESPONSE_HEADER_TIMEOUT=60s
N_API_P_NEWAPI_IDLE_CONN_TIMEOUT=90s
N_API_P_NEWAPI_TOTAL_TIMEOUT=10m
